{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:gate": "eslint lib/deliverables lib/notifications lib/work-jobs lib/quality app/api/work app/api/deliverables app/api/notifications --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:gate": "tsc --noEmit -p tsconfig.release-gate.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:gate": "vitest run lib/deliverables/word-metrics.test.ts lib/deliverables/word-job-ui-state.test.ts lib/deliverables/docx-binary-integrity.test.ts lib/deliverables/download-route.test.ts lib/deliverables/download-client.test.ts lib/deliverables/content-quality.test.ts lib/deliverables/word-pipeline-smoke.test.ts lib/work-jobs/job-status.test.ts lib/work-jobs/run.idempotency.test.ts lib/notifications/work-lifecycle.test.ts lib/notifications/result-resolution.test.ts lib/notifications/result-messages.test.ts",
    "test:integration": "vitest run lib/deliverables/word-completion.integration.test.ts lib/quality/word-notification-regression.test.ts",
    "test:word-e2e": "vitest run lib/deliverables/word-stage3.e2e.test.ts lib/deliverables/word-e2e-pipeline.test.ts lib/quality/word-notification-regression.test.ts",
    "test:notification-e2e": "vitest run lib/notifications/work-lifecycle.test.ts lib/quality/word-notification-regression.test.ts",
    "release-gate": "node scripts/release-gate.mjs",
    "release-gate:ci": "node scripts/release-gate.mjs",
    "test:reliability-1000": "RELIABILITY_RUNS=1000 vitest run lib/reliability/e2e-1000.test.ts lib/reliability/x-post-1000.test.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.13.5",
    "@clerk/nextjs": "^7.5.13",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
